{
	"name": "@elnora-ai/cli",
	"version": "2.0.2",
	"description": "Elnora AI Platform CLI",
	"type": "module",
	"bin": {
		"elnora": "dist/cli.js"
	},
	"main": "dist/cli.js",
	"files": [
		"dist/",
		"scripts/postinstall.mjs",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"postinstall": "node scripts/postinstall.mjs",
		"build": "node scripts/build-npm.mjs",
		"build:binary": "node scripts/build.mjs --pkg",
		"dev": "tsx src/cli.ts",
		"audit:mcp-parity": "tsx scripts/audit-mcp-parity.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check src/ __tests__/",
		"lint:fix": "biome check --write src/ __tests__/",
		"format": "biome format --write src/ __tests__/",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"elnora",
		"cli",
		"bioprotocol",
		"mcp",
		"life-sciences",
		"agent"
	],
	"author": "Elnora AI <support@elnora.ai>",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Elnora-AI/elnora-cli"
	},
	"homepage": "https://platform.elnora.ai",
	"packageManager": "pnpm@10.33.0",
	"dependencies": {
		"@commander-js/extra-typings": "^14.0.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"commander": "^14.0.3",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.2",
		"picocolors": "^1.1.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/express": "^5.0.6",
		"@types/node": "^25.9.1",
		"@yao-pkg/pkg": "^6.19.0",
		"esbuild": "^0.28.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.6"
	},
	"pnpm": {
		"overrides": {
			"@hono/node-server": ">=1.19.13",
			"fast-uri": ">=3.1.2",
			"hono": ">=4.12.18",
			"ip-address": ">=10.1.1",
			"postcss": ">=8.5.10",
			"vite": "8.0.5"
		}
	}
}
